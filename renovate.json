{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchPackageNames": ["com.mojang:minecraft"],
      "enabled": false
    },
    {
      "matchPackageNames": ["net.fabricmc:*", "net.fabricmc.fabric-api:*"],
      "registryUrls": [
        "https://repo.maven.apache.org/maven2",
        "https://maven.fabricmc.net/"
      ]
    },
    {
      "matchPackageNames": ["dev.isxander:*", "dev.isxander.yacl:*"],
      "registryUrls": ["https://maven.isxander.dev/releases"]
    },
    {
      "matchPackageNames": ["maven.modrinth:*"],
      "registryUrls": ["https://api.modrinth.com/maven"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchManagers": ["gradle"],
      "groupName": "gradle dependencies",
      "recreateWhen": "never"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchManagers": ["gradle-wrapper"],
      "groupName": "gradle wrapper",
      "recreateWhen": "never"
    },
    {
      "matchDatasources": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker images"
    }
  ]
}
